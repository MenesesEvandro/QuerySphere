#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# The environment affects error reporting and specific optimizations.
# Use 'development' for local work and 'production' on a live server.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Base URL of your application, with a trailing slash.
app.baseURL = 'http://localhost:8080/'

# Default language for the application.
# Supported: en-US, pt-BR, es-ES
app.defaultLocale = 'pt-BR'

# Session configuration
app.sessionDriver = CodeIgniter\Session\Handlers\FileHandler
app.sessionCookieName = ci_session
app.sessionExpiration = 7200
app.sessionSavePath = writable/sessions

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Encryption key. Must be a 32-character long, random string.
# You can generate one using: openssl rand -base64 32
#--------------------------------------------------------------------
encryption.key = ''

#--------------------------------------------------------------------
# CUSTOM APP SETTINGS
#--------------------------------------------------------------------
# Enable or disable query logging to the writable/logs/querys directory.
QUERY_LOGGING = true

# If true, uses the web server's authenticated user for logging identity.
QUERY_LOG_USE_WEB_USER = false

# The $_SERVER key to use for the web user's identity (e.g., REMOTE_USER).
QUERY_LOG_WEB_USER_KEY = REMOTE_USER

#--------------------------------------------------------------------
# THROTTLER
#--------------------------------------------------------------------
# The maximum number of requests allowed per minute for a single IP
# on routes protected by the 'throttle' filter.
throttler.maxRequests = 10

#--------------------------------------------------------------------
# AUDIT LOGGING
#--------------------------------------------------------------------
# Enable or disable audit logging for critical operations.
AUDIT_LOGGING = true

# Comma-separated list of destructive keywords to monitor for in queries.
# Case-insensitive, matches whole words.
AUDIT_KEYWORDS = 'DROP,TRUNCATE,ALTER,DELETE'

#--------------------------------------------------------------------
# SESSION INACTIVITY TIMEOUT
#--------------------------------------------------------------------
# Enable or disable the automatic logout due to inactivity.
SESSION_TIMEOUT_ENABLED = true

# The number of minutes of inactivity before the warning modal is shown.
SESSION_TIMEOUT_MINUTES = 15

# The duration, in seconds, of the warning countdown before logout.
SESSION_TIMEOUT_WARNING_SECONDS = 30